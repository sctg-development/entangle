# Public DNS name pointing at this host (needed for the "tls" profile).
WORMHOLE_DOMAIN=wormhole.example.org
# Optional: bind addresses, e.g. 127.0.0.1:4000 when Caddy is the only entry.
#MAILBOX_BIND=127.0.0.1:4000
#RELAY_BIND=4001
# Optional: pin or replace the images (default: docker.io/sctg/wormhole-*:latest).
#WORMHOLE_MAILBOX_IMAGE=docker.io/sctg/wormhole-mailbox:latest
#WORMHOLE_RELAY_IMAGE=docker.io/sctg/wormhole-relay:latest

# Browser page (profile "web"): wormhole AppID. Must match the entangle clients
# (default github.com/sctg-development/entangle since v0.8.1; v0.8.0 and earlier
# used github.com/gowtham-sai-yadav/claude-teleport).
#WORMHOLE_APP_ID=github.com/sctg-development/entangle
