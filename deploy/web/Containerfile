# --- Build stage 1: Rust server + WebAssembly client ---
FROM rust:1.94-slim AS rust

RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*
RUN cargo install wasm-pack

WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/

RUN cargo build --release -p wormhole-page-server
RUN cd crates/wormhole-wasm && wasm-pack build --target web --release

# --- Build stage 2: React UI (HeroUI + Tailwind), SRI hashes, service worker ---
FROM node:24-slim AS web

WORKDIR /web
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json vite.config.ts index.html ./
COPY scripts/ scripts/
COPY src/ src/
COPY public/ public/
# The WebAssembly module is served from /static/wasm/ (hashed by scripts/postbuild.mjs)
COPY --from=rust /build/crates/wormhole-wasm/pkg/wormhole_wasm_bg.wasm public/wasm/
COPY --from=rust /build/crates/wormhole-wasm/pkg/wormhole_wasm.js public/wasm/
RUN npm run build

# --- Runtime stage ---
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*

COPY --from=rust /build/target/release/wormhole-page-server /usr/local/bin/
COPY --from=web /web/dist/ /app/static/

EXPOSE 8080

ENTRYPOINT ["wormhole-page-server"]
CMD ["--port", "8080", "--static-dir", "/app/static"]
